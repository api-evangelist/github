          "name": "GitHub Unstargist",
          "request": {
            "name": "GitHub Unstargist",
            "description": {
              "content": "This API operation allows authenticated users to remove their star from a previously starred GitHub Gist by sending a DELETE request to the endpoint with the specific Gist ID. When executed successfully, it removes the user's star designation from the specified Gist, effectively indicating that the user no longer wishes to mark that Gist as a favorite or bookmark it for later reference. This is part of GitHub's Gist starring functionality that helps users curate and organize code snippets they find valuable or want to track.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gists",
                ":gist_id",
                "star"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "gist_id",
                  "description": "(Required) The unique identifier of the gist."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
