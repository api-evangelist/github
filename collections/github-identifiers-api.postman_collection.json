            },
            "url": {
              "path": [
                "repos",
                ":owner",
                ":repo",
                "actions",
                "caches",
                ":cache_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) The account owner of the repository. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) The name of the repository without the `.git` extension. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "cache_id",
                  "description": "(Required) The unique identifier of the GitHub Actions cache."
