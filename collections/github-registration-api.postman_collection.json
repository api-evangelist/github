      "item": [
        {
          "id": "5d203276-199c-4065-a200-ff488edefcf9",
          "name": "GitHub Create Registration Token for an Organization",
          "request": {
            "name": "GitHub Create Registration Token for an Organization",
            "description": {
              "content": "Returns a token that you can pass to the `config` script. The token expires after one hour.\n\nFor example, you can replace `TOKEN` in the following example with the registration token provided by this endpoint to configure your self-hosted runner:\n\n```\n./config.sh --url https://github.com/octo-org --token TOKEN\n```\n\nAuthenticated users must have admin access to the organization to use this endpoint.\n\nOAuth tokens and personal access tokens (classic) need the`admin:org` scope to use this endpoint. If the repository is private, OAuth tokens and personal access tokens (classic) need the `repo` scope to use this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                "actions",
                "runners",
                "registration-token"
              ],
              "host": [
                "{{orgs-org-actions-runners-registration-token-Url}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org",
                  "description": "(Required) The organization name. The name is not case sensitive."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "b00ca7e4-571e-4aab-82fc-d096f3efc890",
              "name": "Response",
              "originalRequest": {
