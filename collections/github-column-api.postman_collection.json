          "name": "GitHub Delete Project Column",
          "request": {
            "name": "GitHub Delete Project Column",
            "description": {
              "content": "The Delete Project Column operation removes a specific column from a GitHub project board by making a DELETE request to the /projects/columns/{column_id} endpoint. This API call permanently deletes the specified column identified by its unique column_id parameter, along with all the cards contained within that column. The operation requires appropriate authentication and permissions to modify the project, typically needing write access to the repository or organization that owns the project. Once executed successfully, the column and its contents are irreversibly removed from the project board, so users should exercise caution when performing this operation to avoid accidental data loss.",
              "type": "text/plain"
            },
            "url": {
              "path": [
