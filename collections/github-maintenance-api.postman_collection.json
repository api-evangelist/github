        {
          "id": "8784255f-3ba0-4699-a615-659a026e0e55",
          "name": "GitHub Enable or Disable Maintenance Mode",
          "request": {
            "name": "GitHub Enable or Disable Maintenance Mode",
            "description": {
              "content": "**Note:** The request body for this operation must be submitted as `application/x-www-form-urlencoded` data. You can submit a parameter value as a string, or you can use a tool such as `curl` to submit a parameter value as the contents of a text file. For more information, see the [`curl` documentation](https://curl.se/docs/manpage.html#--data-urlencode).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{protocol}}",
              "port": "hostname",
              "path": [
                "setup",
                "api",
                "maintenance"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "HOSTNAME",
                  "key": "hostname"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "maintenance",
                  "value": "<string>",
                  "description": "(Required) A JSON string with the attributes `enabled` and `when`.\n\nThe possible values for `enabled` are `true` and `false`. When it's `false`, the attribute `when` is ignored and the maintenance mode is turned off. `when` defines the time period when the maintenance was enabled.\n\nThe possible values for `when` are `now` or any date parseable by [mojombo/chronic](https://github.com/mojombo/chronic)."
                }
              ]
            }
          },
          "response": [
            {
              "id": "ce007725-a1cb-4846-893c-1c804cb5d09a",
              "name": "Response",
              "originalRequest": {
