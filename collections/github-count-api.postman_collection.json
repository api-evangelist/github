        {
          "id": "3ea8c76a-f44a-4ebe-b42c-9978bf74ba76",
          "name": "GitHub Get the Weekly Commit Count",
          "request": {
            "name": "GitHub Get the Weekly Commit Count",
            "description": {
              "content": "Returns the total commit counts for the `owner` and total commit counts in `all`. `all` is everyone combined, including the `owner` in the last 52 weeks. If you'd like to get the commit counts for non-owners, you can subtract `owner` from `all`.\n\nThe array order is oldest week (index 0) to most recent week.\n\nThe most recent week is seven days ago at UTC midnight to today at UTC midnight.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repos",
                ":owner",
                ":repo",
                "stats",
                "participation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) The account owner of the repository. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) The name of the repository without the `.git` extension. The name is not case sensitive."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
