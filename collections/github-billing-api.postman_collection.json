          "id": "1a7c9d38-9432-4783-977d-738ed6f78f84",
          "name": "GitHub Get GitHub Advanced Security Active Committers for an Enterprise",
          "request": {
            "name": "GitHub Get GitHub Advanced Security Active Committers for an Enterprise",
            "description": {
              "content": "Gets the GitHub Advanced Security active committers for an enterprise per repository.\n\nEach distinct user login across all repositories is counted as a single Advanced Security seat, so the `total_advanced_security_committers` is not the sum of active_users for each repository.\n\nThe total number of repositories with committer information is tracked by the `total_count` field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "enterprises",
                ":enterprise",
                "settings",
                "billing",
                "advanced-security"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "30",
                  "description": "The number of results per page (max 100). For more information, see \"[Using pagination in the REST API](https://docs.github.com/enterprise-server@3.9/rest/using-the-rest-api/using-pagination-in-the-rest-api).\""
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number of the results to fetch. For more information, see \"[Using pagination in the REST API](https://docs.github.com/enterprise-server@3.9/rest/using-the-rest-api/using-pagination-in-the-rest-api).\""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "enterprise",
                  "description": "(Required) The slug version of the enterprise name. You can also substitute this value with the enterprise id."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
