          "name": "GitHub Unlock an Organization Repository",
          "request": {
            "name": "GitHub Unlock an Organization Repository",
            "description": {
              "content": "Unlocks a repository that was locked for migration. You should unlock each migrated repository and [delete them](https://docs.github.com/enterprise-server@3.9/rest/repos/repos#delete-a-repository) when the migration is complete and you no longer need the source data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                "migrations",
                ":migration_id",
                "repos",
                ":repo_name",
                "lock"
              ],
              "host": [
                "{{orgs-org-migrations-migration_id-repos-repo_name-lock-Url}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org",
                  "description": "(Required) The organization name. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "migration_id",
                  "description": "(Required) The unique identifier of the migration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_name",
                  "description": "(Required) repo_name parameter"
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
