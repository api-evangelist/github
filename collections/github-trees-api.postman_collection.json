          "name": "GitHub Create Tree",
          "request": {
            "name": "GitHub Create Tree",
            "description": {
              "content": "The tree creation API accepts nested entries. If you specify both a tree and a nested path modifying that tree, this endpoint will overwrite the contents of the tree with the new path contents, and create a new tree structure.\n\nIf you use this endpoint to add, delete, or modify the file contents in a tree, you will need to commit the tree and then update a branch to point to the commit. For more information see \"[Create a commit](https://docs.github.com/enterprise-server@3.9/rest/git/commits#create-a-commit)\" and \"[Update a reference](https://docs.github.com/enterprise-server@3.9/rest/git/refs#update-a-reference).\"\n\nReturns an error if you try to delete a file that does not exist.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repos",
                ":owner",
                ":repo",
                "git",
                "trees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) The account owner of the repository. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) The name of the repository without the `.git` extension. The name is not case sensitive."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
