          "id": "4d112df3-7b5f-45d9-8cfd-114662e3c545",
          "name": "GitHub Add Security Manager Team",
          "request": {
            "name": "GitHub Add Security Manager Team",
            "description": {
              "content": "Adds a team as a security manager for an organization. For more information, see \"[Managing security for an organization](https://docs.github.com/enterprise-server@3.9/organizations/managing-peoples-access-to-your-organization-with-roles/managing-security-managers-in-your-organization) for an organization.\"\n\nThe authenticated user must be an administrator for the organization to use this endpoint.\n\nOAuth app tokens and personal access tokens (classic) need the `write:org` scope to use this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                "security-managers",
                "teams",
                ":team_slug"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org",
                  "description": "(Required) The organization name. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "team_slug",
                  "description": "(Required) The slug of the team name."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
