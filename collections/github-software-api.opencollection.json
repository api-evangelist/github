{
  "opencollection": "1.0.0",
  "info": {
    "name": "github-repos-api Software API",
    "version": "1.1.4"
  },
  "items": [
    {
      "info": {
        "name": "Software",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GitHub Export Software Bill of Materials (sbom) for Repository.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}/repos/:owner/:repo/dependency-graph/sbom",
            "headers": [
              {
                "name": "Authorization",
                "value": "example_value"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "example_value"
              },
              {
                "name": "Accept",
                "value": "example_value"
              }
            ],
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "The account owner of the repository. The name is not case sensitive."
              },
              {
                "name": "repo",
                "value": "",
                "type": "path",
                "description": "The name of the repository without the `.git` extension. The name is not case sensitive."
              }
            ]
          },
          "docs": "Exports the software bill of materials (SBOM) for a repository in SPDX JSON format."
        }
      ]
    }
  ],
  "bundled": true
}