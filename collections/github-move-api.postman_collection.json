        {
          "id": "9809294a-2125-41af-9b38-0e3da9543985",
          "name": "GitHub Move Project Card",
          "request": {
            "name": "GitHub Move Project Card",
            "description": {
              "content": "This API operation moves a project card to a different position within the same column or to a different column entirely within a GitHub project board. When making a POST request to /projects/columns/cards/{card_id}/moves, you specify the card_id of the card you want to relocate and provide parameters in the request body to define the new position, such as the target column_id and the desired position relative to other cards (top, bottom, or after a specific card). This endpoint is useful for programmatically organizing and reordering cards within project boards, enabling automation of project management workflows and integration with external tools. The operation requires appropriate authentication and permissions to modify the project board, and upon success, it returns the updated card object with its new position information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                "columns",
                "cards",
                ":card_id",
                "moves"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "card_id",
                  "description": "(Required) The unique identifier of the card."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
