          "id": "cef8c6f0-361d-4086-984c-94b3d3647be0",
          "name": "GitHub Enable or Disable Security Feature for an Organization",
          "request": {
            "name": "GitHub Enable or Disable Security Feature for an Organization",
            "description": {
              "content": "Enables or disables the specified security feature for all eligible repositories in an organization. For more information, see \"[Managing security managers in your organization](https://docs.github.com/enterprise-server@3.9/organizations/managing-peoples-access-to-your-organization-with-roles/managing-security-managers-in-your-organization).\"\n\nThe authenticated user must be an organization owner or be member of a team with the security manager role to use this endpoint.\n\nOAuth app tokens and personal access tokens (classic) need the `write:org` scope to use this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                ":security_product",
                ":enablement"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org",
                  "description": "(Required) The organization name. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "security_product",
                  "description": "(Required) The security feature to enable or disable."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "enablement",
                  "description": "(Required) The action to take.\n\n`enable_all` means to enable the specified security feature for all repositories in the organization.\n`disable_all` means to disable the specified security feature for all repositories in the organization."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
