{
  "opencollection": "1.0.0",
  "info": {
    "name": "github-repos-api Last API",
    "version": "1.1.4"
  },
  "items": [
    {
      "info": {
        "name": "Last",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GitHub Get the Last Year of Commit Activity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{hostname}/repos/:owner/:repo/stats/commit_activity",
            "headers": [
              {
                "name": "Authorization",
                "value": "example_value"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "example_value"
              },
              {
                "name": "Accept",
                "value": "example_value"
              }
            ],
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "The account owner of the repository. The name is not case sensitive."
              },
              {
                "name": "repo",
                "value": "",
                "type": "path",
                "description": "The name of the repository without the `.git` extension. The name is not case sensitive."
              }
            ]
          },
          "docs": "Returns the last year of commit activity grouped by week. The `days` array is a group of commits per day, starting on `Sunday`."
        }
      ]
    }
  ],
  "bundled": true
}