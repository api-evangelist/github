          "request": {
            "name": "GitHub Get List of Conflicting Packages During Docker Migration for Organization",
            "description": {
              "content": "Lists all packages that are in a specific organization, are readable by the requesting user, and that encountered a conflict during a Docker migration.\n\nOAuth app tokens and personal access tokens (classic) need the `read:packages` scope to use this endpoint.",
