          "name": "GitHub Get the Status of Services Running on All Replica Nodes",
          "request": {
            "name": "GitHub Get the Status of Services Running on All Replica Nodes",
            "description": {
              "content": "Gets the status of all services running on each replica node.\nThis endpoint may take several seconds to reply.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{protocol}}",
              "port": "hostname",
              "path": [
