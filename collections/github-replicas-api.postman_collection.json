                  "description": "The UUID which identifies a node."
                },
                {
                  "disabled": false,
                  "key": "cluster_roles",
                  "value": "<string>",
                  "description": "The cluster roles from the cluster configuration file."
                }
              ],
              "variable": [
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "HOSTNAME",
                  "key": "hostname"
                }
              ]
            },
            "header": [
