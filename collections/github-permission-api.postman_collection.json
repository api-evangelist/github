          "name": "GitHub Get Project Permission for User",
          "request": {
            "name": "GitHub Get Project Permission for User",
            "description": {
              "content": "Returns the collaborator's permission level for an organization project. Possible values for the `permission` key: `admin`, `write`, `read`, `none`. You must be an organization owner or a project `admin` to review a user's permission level.",
