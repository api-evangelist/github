        {
          "id": "b0874294-1f9b-4960-b666-62e9aa83579d",
          "name": "GitHub Render Markdown Document",
          "request": {
            "name": "GitHub Render Markdown Document",
            "description": {
              "content": "This API operation accepts a POST request to the /markdown endpoint and is used to render Markdown-formatted text into its processed output, typically HTML. When you send a Markdown document to this endpoint, it parses the Markdown syntax and returns the rendered result, allowing applications to convert user-written Markdown content into display-ready formatted text without implementing their own Markdown parser.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "markdown"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"<string>\",\n  \"mode\": \"markdown\",\n  \"context\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9849c215-3c07-4ce9-a640-66da6010b7f2",
              "name": "Response",
              "originalRequest": {
