                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "thread_id",
                  "description": "(Required) The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/enterprise-server@3.9/rest/activity/notifications#list-notifications-for-the-authenticated-user))."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
