          "name": "GitHub Mark Thread as Read",
          "request": {
            "name": "GitHub Mark Thread as Read",
            "description": {
              "content": "Marks a thread as \"read.\" Marking a thread as \"read\" is equivalent to clicking a notification in your notification inbox on GitHub Enterprise Server: https://github.com/notifications.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "notifications",
                "threads",
                ":thread_id"
