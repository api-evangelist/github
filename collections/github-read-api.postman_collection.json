        {
          "id": "c4abcd91-f8c3-44ed-b7fd-a9a6d965a669",
          "name": "GitHub Mark Repository Notifications as Read",
          "request": {
            "name": "GitHub Mark Repository Notifications as Read",
            "description": {
              "content": "Marks all notifications in a repository as \"read\" for the current user. If the number of notifications is too large to complete in one request, you will receive a `202 Accepted` status and GitHub Enterprise Server will run an asynchronous process to mark notifications as \"read.\" To check whether any \"unread\" notifications remain, you can use the [List repository notifications for the authenticated user](https://docs.github.com/enterprise-server@3.9/rest/activity/notifications#list-repository-notifications-for-the-authenticated-user) endpoint and pass the query parameter `all=false`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repos",
                ":owner",
                ":repo",
                "notifications"
              ],
              "host": [
                "{{repos-owner-repo-notifications-Url}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) The account owner of the repository. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) The name of the repository without the `.git` extension. The name is not case sensitive."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28",
                "description": ""
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"last_read_at\": \"<dateTime>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
