      "item": [
        {
          "id": "f323eadc-d77b-4003-9559-66643b56b2a8",
          "name": "GitHub List Matching References",
          "request": {
            "name": "GitHub List Matching References",
            "description": {
              "content": "Returns an array of references from your Git database that match the supplied name. The `:ref` in the URL must be formatted as `heads/<branch name>` for branches and `tags/<tag name>` for tags. If the `:ref` doesn't exist in the repository, but existing refs start with `:ref`, they will be returned as an array.\n\nWhen you use this endpoint without providing a `:ref`, it will return an array of all the references from your Git database, including notes and stashes if they exist on the server. Anything in the namespace is returned, not just `heads` and `tags`.\n\n**Note:** You need to explicitly [request a pull request](https://docs.github.com/enterprise-server@3.9/rest/pulls/pulls#get-a-pull-request) to trigger a test merge commit, which checks the mergeability of pull requests. For more information, see \"[Checking mergeability of pull requests](https://docs.github.com/enterprise-server@3.9/rest/guides/getting-started-with-the-git-database-api#checking-mergeability-of-pull-requests)\".\n\nIf you request matching references for a branch named `feature` but the branch `feature` doesn't exist, the response can still include other matching head refs that start with the word `feature`, such as `featureA` and `featureB`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repos",
                ":owner",
                ":repo",
                "git",
                "matching-refs",
                ":ref"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) The account owner of the repository. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo",
                  "description": "(Required) The name of the repository without the `.git` extension. The name is not case sensitive."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ref",
                  "description": "(Required) The Git reference. For more information, see \"[Git References](https://git-scm.com/book/en/v2/Git-Internals-Git-References)\" in the Git documentation."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
