      "item": [
        {
          "id": "80f0f9fc-5bf9-4c2c-a02c-d9bce7328559",
          "name": "GitHub Revoke an Installation Access Token",
          "request": {
            "name": "GitHub Revoke an Installation Access Token",
            "description": {
              "content": "Revokes the installation token you're using to authenticate as an installation and access this endpoint.\n\nOnce an installation token is revoked, the token is invalidated and cannot be used. Other endpoints that require the revoked installation token must have a new installation token to work. You can create a new token using the \"[Create an installation access token for an app](https://docs.github.com/enterprise-server@3.9/rest/apps/apps#create-an-installation-access-token-for-an-app)\" endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "installation",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "119bc696-a99b-4383-bedf-b78c27b438a8",
              "name": "Response",
              "originalRequest": {
                "url": {
