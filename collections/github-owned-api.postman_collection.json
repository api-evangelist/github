        {
          "id": "41f82daa-5fbb-4d0b-81c9-ea865c408152",
          "name": "GitHub List Package Versions for Package Owned by an Organization",
          "request": {
            "name": "GitHub List Package Versions for Package Owned by an Organization",
            "description": {
              "content": "Lists package versions for a package owned by an organization.\n\nOAuth app tokens and personal access tokens (classic) need the `repo` scope to use this endpoint if the `package_type` belongs to a GitHub Packages registry that only supports repository-scoped permissions. For the list of these registries, see \"[About permissions for GitHub Packages](https://docs.github.com/enterprise-server@3.9/packages/learn-github-packages/about-permissions-for-github-packages#permissions-for-repository-scoped-packages).\"",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                "packages",
                ":package_type",
                ":package_name",
                "versions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number of the results to fetch. For more information, see \"[Using pagination in the REST API](https://docs.github.com/enterprise-server@3.9/rest/using-the-rest-api/using-pagination-in-the-rest-api).\""
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "30",
                  "description": "The number of results per page (max 100). For more information, see \"[Using pagination in the REST API](https://docs.github.com/enterprise-server@3.9/rest/using-the-rest-api/using-pagination-in-the-rest-api).\""
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "active",
                  "description": "The state of the package, either active or deleted."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "package_type",
                  "description": "(Required) The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "package_name",
                  "description": "(Required) The name of the package."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org",
                  "description": "(Required) The organization name. The name is not case sensitive."
                },
                {
                  "description": "Self-hosted Enterprise Server hostname",
                  "type": "any",
                  "value": "{{hostname}}",
                  "key": "hostname"
                },
                {
                  "description": "Self-hosted Enterprise Server protocol",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
