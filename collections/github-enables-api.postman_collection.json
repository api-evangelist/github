          "name": "GitHub Enable Selected Repository for Github Actions in an Organization",
          "request": {
            "name": "GitHub Enable Selected Repository for Github Actions in an Organization",
            "description": {
              "content": "Adds a repository to the list of selected repositories that are enabled for GitHub Actions in an organization. To use this endpoint, the organization permission policy for `enabled_repositories` must be must be configured to `selected`. For more information, see \"[Set GitHub Actions permissions for an organization](#set-github-actions-permissions-for-an-organization).\"\n\nOAuth tokens and personal access tokens (classic) need the `admin:org` scope to use this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":org",
                "actions",
                "permissions",
                "repositories",
                ":repository_id"
              ],
              "host": [
                "{{orgs-org-actions-permissions-repositories-repository_id-Url}}"
              ],
              "query": [],
