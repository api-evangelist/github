          "name": "GitHub Start Configuration Process",
          "request": {
            "name": "GitHub Start Configuration Process",
            "description": {
              "content": "The GitHub Setup API's `/setup/api/configure` endpoint accepts POST requests to initiate the configuration process for a new GitHub Enterprise Server instance. This endpoint is typically called during the initial setup phase when administrators need to establish basic system settings such as management console password, hostname, and other foundational configurations. The API operation triggers the configuration workflow that prepares the instance for use, and it returns a response indicating whether the configuration process has successfully started or if any errors occurred during initialization.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "{{protocol}}",
              "port": "hostname",
              "path": [
