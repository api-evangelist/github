{
  "opencollection": "1.0.0",
  "info": {
    "name": "github-repos-api State API",
    "version": "1.1.4"
  },
  "items": [
    {
      "info": {
        "name": "State",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GitHub Create Tag Protection State for Repository",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{hostname}/repos/:owner/:repo/tags/protection",
            "headers": [
              {
                "name": "Authorization",
                "value": "example_value"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "example_value"
              },
              {
                "name": "Accept",
                "value": "example_value"
              }
            ],
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "The account owner of the repository. The name is not case sensitive."
              },
              {
                "name": "repo",
                "value": "",
                "type": "path",
                "description": "The name of the repository without the `.git` extension. The name is not case sensitive."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This creates a tag protection state for a repository.\nThis endpoint is only available to repository administrators."
        },
        {
          "info": {
            "name": "GitHub Delete Tag Protection State for Repository",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{hostname}/repos/:owner/:repo/tags/protection/:tag_protection_id",
            "headers": [
              {
                "name": "Authorization",
                "value": "example_value"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "example_value"
              },
              {
                "name": "Accept",
                "value": "example_value"
              }
            ],
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "The account owner of the repository. The name is not case sensitive."
              },
              {
                "name": "repo",
                "value": "",
                "type": "path",
                "description": "The name of the repository without the `.git` extension. The name is not case sensitive."
              },
              {
                "name": "tag_protection_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the tag protection."
              }
            ]
          },
          "docs": "This deletes a tag protection state for a repository.\nThis endpoint is only available to repository administrators."
        }
      ]
    }
  ],
  "bundled": true
}